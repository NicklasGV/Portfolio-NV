# Apache config for the built site on shared hosting.
# Everything here ships to /public_html/ alongside index.html.

# ---------------------------------------------------------------------------
# SPA routing
# ---------------------------------------------------------------------------
# Vue Router uses history mode, so /arcade and /arcade/bug-hunt have no file
# of their own. Without this, Apache returns a real 404 for those URLs and the
# routes only work if you navigate to them from the front page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host. www serves the very same site, so without this Google sees
  # two copies of every page. Non-www is the version already indexed.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Leave real files and directories alone (assets, sitemap.xml, robots.txt).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is handled by the app.
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# Vite fingerprints asset filenames, so those can be cached hard. index.html
# must not be, or a deploy will not reach anyone still holding the old copy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml text/xsl image/svg+xml
</IfModule>

# The sitemap's stylesheet. X-Content-Type-Options is nosniff, so the browser
# will refuse to apply it unless the server names the type correctly.
<IfModule mod_mime.c>
  AddType text/xsl .xsl
</IfModule>

ErrorDocument 404 /index.html
